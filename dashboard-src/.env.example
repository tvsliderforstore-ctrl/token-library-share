# Product Token Library & Product Intelligence Dashboard
# ── Environment configuration ────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# HTTP server
PTL_PORT=4310
PTL_HOST=127.0.0.1

# Database file (SQLite via sql.js — pure JS, no native build)
PTL_DB_FILE=C:\\Users\\chlam\\product-token-library\\data\\product-token-library.db

# Taxonomy
PTL_TAXONOMY_VERSION=1.0.0

# Classification confidence thresholds
PTL_CONF_AUTO_ACCEPT=0.95
PTL_CONF_REVIEW=0.75

# Data freshness (hours). FRESH if observed within this window.
PTL_FRESHNESS_HOURS=30

# Base URL the Hermes skill uses to reach the dashboard
PTL_API=http://127.0.0.1:4310

# ── Existing Hermes skills (adapters wrap these; do NOT reimplement) ─────────
# Stock skill (default profile): check_sku.py <SKU> -> JSON {stock_state, price_hkd, checked_at}
PTL_STOCK_SKILL_NAME=stock-status-checker
PTL_STOCK_SKILL_SCRIPT=C:\\Users\\chlam\\AppData\\Local\\hermes\\profiles\\app\\skills\\productivity\\stock-status-checker\\scripts\\check_sku.py

# Price skill (PSOS discount report CSV). RSP=col E (原價), PSP=col F (特價)
PTL_PRICE_SKILL_NAME=psos-discount-report-download
PTL_PRICE_SKILL_SOURCE=PSOS

# Optional reviewer identity recorded on human corrections
PTL_REVIEWER=

# ── Secrets (referenced only; never stored in source or returned by the API) ─
# PSOS_USERNAME=
# PSOS_PASSWORD=
# HERMES_API_KEY=
